[layer_names]

2d_physics/layer_1="Environment"
2d_physics/layer_2="Player Physics"
2d_physics/layer_3="Enemy Physics"
2d_physics/layer_4="Player Hurtbox"
2d_physics/layer_5="Enemy Hurtbox"
2d_physics/layer_6="Player Hitbox"
2d_physics/layer_7="Enemy Hitbox"
2d_physics/layer_8="Object"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
